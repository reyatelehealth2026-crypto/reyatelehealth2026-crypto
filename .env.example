# --- Database (Vercel Postgres / Neon) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Vercel Blob (image storage) ---
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# --- Gemini ---
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# --- Meta / Facebook ---
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_REDIRECT_URI="https://your-domain.com/api/meta/oauth/callback"

# --- Security ---
# 32-byte key, base64-encoded. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="base64-encoded-32-byte-key"
# Session signing secret, >= 32 chars. Generate: openssl rand -base64 32
AUTH_SECRET="random-string-at-least-32-chars-long"

# --- Single admin ---
ADMIN_EMAIL="admin@example.com"
# bcrypt hash. Generate: node -e "console.log(require('bcryptjs').hashSync('yourpassword',10))"
ADMIN_PASSWORD_HASH="$2a$10$..."

# --- Cron ---
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes.
CRON_SECRET="random-cron-secret"
